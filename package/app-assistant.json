{
  "contract": "app-assistant/v1",
  "app": "designer-studio",
  "actions": [
    {
      "id": "media.refine.prepare",
      "description": "Prepare a reference edit of the image attached to this chat turn. The host reviews the exact source, model, instructions and price before approval.",
      "effect": "draft",
      "confirmation": "permission_required",
      "input_schema": {
        "type": "object",
        "properties": {
          "asset_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "revision": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "minLength": 71, "maxLength": 71 },
          "instructions": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "required": ["asset_id", "revision", "sha256", "instructions"],
        "additionalProperties": false
      }
    }
  ]
}
